      "regions_file": "storage/media/training/kontakte/kontakte-edit-regions.json",
      "narration": "Firmenname: bei Firmenkontakten wichtig, bei Personen optional — zum Beispiel der Arbeitgeber."
    },
    {
      "key": "field-contact_role",
