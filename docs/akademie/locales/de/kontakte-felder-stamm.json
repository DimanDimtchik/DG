      "mode": "focus_field",
      "field": "salutation",
      "section": "stamm",
      "regions_file": "storage/media/training/kontakte/kontakte-edit-regions.json",
      "narration": "Anrede: Herr, Frau, Divers, Firma oder Team — optional, hilft bei Briefen. Bei Firma erscheint der Block Mitarbeiter der Firma. Bei Personen der Block Arbeitgeber."
    },
    {
      "key": "field-first_name",
      "screenshot": "storage/media/training/kontakte/kontakte-edit.png",
