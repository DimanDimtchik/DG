RewriteEngine On
RewriteBase /

# Block crawlers
Header set X-Robots-Tag "noindex, nofollow"

# HTTPS erzwingt All-Inkl nach „SSL aktiv“ — hier kein Force-HTTPS
# (sonst Redirect-Schleife, solange das Zertifikat noch fehlt).

# Block config.php direct access
RewriteRule ^config\.php$ - [F,L]

# Route everything through index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php [QSA,L]
